[Unit]
Description=MAL-Updater local recommendation dashboard
After=default.target

[Service]
Type=simple
WorkingDirectory=__MAL_UPDATER_REPO_ROOT__
Environment=PYTHONPATH=__MAL_UPDATER_REPO_ROOT__/src
EnvironmentFile=-__MAL_UPDATER_SERVICE_ENV_FILE__
ExecStart=__MAL_UPDATER_PYTHON_BIN__ -m mal_updater.cli --project-root __MAL_UPDATER_REPO_ROOT__ dashboard-serve --host 127.0.0.1
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__MAL_UPDATER_READ_WRITE_PATHS__
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
