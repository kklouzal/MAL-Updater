# Optional EnvironmentFile for mal-updater.service
# Copy/install to ~/.config/mal-updater-service.env as mode 0600 and adjust as needed.

# Service loop cadence defaults (seconds)
# MAL_UPDATER_SERVICE_SYNC_EVERY_SECONDS=3600
# MAL_UPDATER_SERVICE_HEALTH_EVERY_SECONDS=3600
# MAL_UPDATER_SERVICE_MAL_REFRESH_EVERY_SECONDS=3600
# MAL_UPDATER_SERVICE_LOOP_SLEEP_SECONDS=30

# SQLite physical compaction housekeeping (low-frequency, threshold-gated)
# MAL_UPDATER_SERVICE_DB_COMPACTION_EVERY_SECONDS=604800
# MAL_UPDATER_SERVICE_DB_COMPACTION_MIN_INTERVAL_SECONDS=2592000
# MAL_UPDATER_SERVICE_DB_COMPACTION_MIN_FREELIST_BYTES=134217728
# MAL_UPDATER_SERVICE_DB_COMPACTION_MIN_FREELIST_RATIO=0.10
# MAL_UPDATER_SERVICE_DB_COMPACTION_FREE_SPACE_MARGIN_BYTES=67108864

# Runtime housekeeping (bounded deletion for health JSON only; audit is read-only)
# MAL_UPDATER_SERVICE_HEALTH_HISTORY_RETENTION_EVERY_SECONDS=86400
# MAL_UPDATER_SERVICE_HEALTH_HISTORY_RETENTION_DAYS=90
# MAL_UPDATER_SERVICE_HEALTH_HISTORY_MIN_COUNT=168
# MAL_UPDATER_SERVICE_HEALTH_HISTORY_PRUNE_BATCH_SIZE=100
# MAL_UPDATER_SERVICE_LOG_MAX_BYTES=16777216
# MAL_UPDATER_SERVICE_LOG_RETAINED_GENERATIONS=5
# MAL_UPDATER_SERVICE_RUNTIME_RETENTION_AUDIT_EVERY_SECONDS=604800

# Request-budget thresholds
# MAL_UPDATER_SERVICE_CRUNCHYROLL_HOURLY_LIMIT=180
# MAL_UPDATER_SERVICE_MAL_HOURLY_LIMIT=120
# MAL_UPDATER_SERVICE_WARN_RATIO=0.8
# MAL_UPDATER_SERVICE_CRITICAL_RATIO=0.95
