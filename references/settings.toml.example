# Non-secret runtime configuration.
# Copy to .MAL-Updater/config/settings.toml (or point MAL_UPDATER_SETTINGS_PATH at another file).
# Paths may be absolute or relative to this settings file.

completion_threshold = 0.95
credits_skip_window_seconds = 120
contract_version = "1.0"

[paths]
config_dir = "./"
secrets_dir = "../secrets"
data_dir = "../data"
state_dir = "../state"
cache_dir = "../cache"
db_path = "../data/mal_updater.sqlite3"

[mal]
search_cache_ttl_days = 14  # normalized-query positive cache; key includes limit, fields, and logic version
search_negative_cache_ttl_days = 3  # bounded no-result cache; force refresh bypasses it
detail_cache_ttl_days = 14  # only complete field-covering rows may satisfy a detail read
provider_detail_cache_ttl_days = 30  # Crunchyroll enriched series/audio/season evidence; HIDIVE stays search-only
base_url = "https://api.myanimelist.net/v2"
public_base_url = "https://myanimelist.net"  # public read-only /anime/<id>/<slug>/userrecs aggregate surface; prose/usernames are not retained
auth_url = "https://myanimelist.net/v1/oauth2/authorize"
token_url = "https://myanimelist.net/v1/oauth2/token"
bind_host = "0.0.0.0"
redirect_host = "127.0.0.1"
redirect_port = 8765
request_spacing_seconds = 1.0
request_spacing_jitter_seconds = 0.2
retry_max_attempts = 2  # safe GET/read attempts only; OAuth token POSTs and MAL PUT writes are always single-attempt
retry_backoff_base_seconds = 1.0
retry_backoff_jitter_seconds = 0.25
retry_after_cap_seconds = 60.0

[crunchyroll]
locale = "en-US"
request_spacing_seconds = 22.5
request_spacing_jitter_seconds = 7.5
retry_max_attempts = 2  # safe GET/read attempts only; login and token-refresh POSTs are always single-attempt
retry_backoff_base_seconds = 1.0
retry_backoff_jitter_seconds = 0.25
retry_after_cap_seconds = 60.0

# These are local niceness controls, not undocumented provider rate-limit claims.
# Request-start gates are shared by provider across clients/processes on this host.

[hidive]
request_spacing_seconds = 5.0
request_spacing_jitter_seconds = 1.0
retry_max_attempts = 2  # safe GET/read attempts only; login and token-refresh POSTs are always single-attempt
retry_backoff_base_seconds = 1.0
retry_backoff_jitter_seconds = 0.25
retry_after_cap_seconds = 60.0

[openclaw]
recommendations_webhook_enabled = false
recommendations_webhook_url = "http://127.0.0.1:18789/hooks/agent"
recommendations_webhook_timeout_seconds = 20.0
recommendations_webhook_channel = "discord"
recommendations_webhook_to = "channel:000000000000000000"
recommendations_webhook_delivery_mode = "fresh"  # fresh=daemon-safe low-noise posture; use digest/all for manual broader sends

[openclaw.recommendations_webhook_section_limits]
continue_next = 5
fresh_dubbed_episodes = 5
discovery_candidates = 3
resume_backlog = 2
other = 2

[service]
sync_every_seconds = 3600
full_refresh_every_seconds = 604800  # weekly only for page-bounded Crunchyroll; HIDIVE unattended full refresh remains disabled
health_every_seconds = 3600
mal_refresh_every_seconds = 3600  # lightweight token-refresh lane; distinct from the user-list network refresh
mal_list_refresh_every_seconds = 28800  # 8h, within the conservative 6-12h user-list window; max pages is configured below
recommendation_metadata_refresh_every_seconds = 43200  # 12h bounded seed/discovery hydration
recommendation_full_harvest_every_seconds = 3600  # hourly two-source cold-path batches over public MAL userrecs aggregates
recommendation_full_harvest_stale_after_days = 45  # long refresh horizon for newly added public MAL user recommendations
provider_eligibility_refresh_every_seconds = 3600  # one separately budgeted provider-specific lane per credentialed provider
recommend_maintain_every_seconds = 3600  # DB/local-only recommendation snapshot + health materialization
recommendations_webhook_push_every_seconds = 0  # disabled by default; set >0 to let the daemon push changed recommendation digests into OpenClaw using delivery_mode + item-aware dedupe
loop_sleep_seconds = 30
startup_grace_seconds = 30  # applies only to long-lived service-run; manual service-run-once remains immediate
lease_stale_after_seconds = 1800  # operator evidence threshold; kernel locks safely recover immediately when an owning process dies
crunchyroll_hourly_limit = 180  # legacy Crunchyroll-specific override
source_provider_hourly_limit = 180
source_provider_warn_backoff_floor_seconds = 0
source_provider_critical_backoff_floor_seconds = 0
source_provider_auth_failure_backoff_floor_seconds = 0
mal_hourly_limit = 120
warn_ratio = 0.8
critical_ratio = 0.95

[service.provider_hourly_limits]
hidive = 72  # built-in default shown explicitly here; override only when this host needs a different HIDIVE budget

[service.task_hourly_limits]
mal_list_refresh = 6  # task cap and MAL provider-global cap are both enforced
sync_apply = 48  # additional task-scoped cap; provider-global MAL cap is still enforced, and legacy unattributed events are conservatively included
recommend_metadata_refresh = 12
recommend_full_harvest = 16  # task cap and MAL provider-global cap are both enforced
recommend_provider_eligibility_crunchyroll = 72  # local safety budget, not an external provider-limit claim
recommend_provider_eligibility_hidive = 32

[service.task_execute_limits]
mal_list_refresh_pages = 3
sync_apply = 8  # built-in default shown explicitly here; positive values bound unattended writes, while 0 disables this scheduler lane (manual CLI --limit 0 keeps its explicit full-scan meaning)
recommend_metadata_refresh = 3
recommend_metadata_discovery_targets = 5
recommend_full_harvest = 2  # positive source-title batch size; 0 disables daemon lane rather than becoming unbounded
recommend_full_harvest_pages = 3  # advertised same-origin public userrecs pages per source per run; unfinished coherent generations pause/resume before terminal atomic publish
recommend_provider_eligibility_candidates = 4  # per credentialed provider lane; 0 disables the daemon lane rather than becoming unbounded
recommend_provider_eligibility_search_results = 5
recommend_provider_eligibility_queries_per_candidate = 1
recommendation_snapshot = 100
push_recommendations_webhook = 20  # optional daemon push batch size for recommendation delivery into OpenClaw; actual sections are still trimmed by openclaw.recommendations_webhook_delivery_mode + section_limits

[service.task_projected_request_counts]
mal_refresh = 1  # built-in default shown explicitly here; fresh installs now seed unattended MAL token refresh with a small non-zero request-cost estimate, but learned history can replace the seed once real runs exist
mal_list_refresh = 3
sync_apply = 8  # built-in default shown explicitly here; keep this aligned with the unattended apply batch posture unless this host has strong evidence for a different per-run MAL request cost
recommend_metadata_refresh = 8
recommend_full_harvest = 12
recommend_provider_eligibility_crunchyroll = 28
recommend_provider_eligibility_hidive = 8
sync_fetch_crunchyroll = 12  # optional task-wide fallback/override when you want one Crunchyroll estimate outside mode-specific defaults; explicit task-wide values beat shipped mode seeds

[service.task_projected_request_counts_by_mode.sync_fetch_crunchyroll]
incremental = 4  # built-in default shown explicitly here; fresh installs now seed the ordinary Crunchyroll fetch path with a conservative non-zero cost
full_refresh = 55  # built-in default shown explicitly here; cold-start Crunchyroll full refreshes are materially heavier than incremental fetches, but learned full-refresh history can replace this seed

[service.task_projected_request_counts_by_mode.sync_fetch_hidive]
incremental = 4  # built-in default shown explicitly here; fresh installs now seed the ordinary HIDIVE fetch path with a conservative non-zero cost
full_refresh = 71  # built-in default shown explicitly here; use mode-specific task defaults when a lane's full refresh is much more expensive than incremental fetches, but learned full-refresh history can replace this seed

[service.provider_projected_request_history_windows]
crunchyroll = 7  # built-in default shown explicitly here; override only when this host needs a different learned-history depth
hidive = 9  # built-in default shown explicitly here

[service.task_projected_request_history_windows]
mal_refresh = 3  # built-in default shown explicitly here; keep MAL token refresh learning shallow because the lane is normally tiny and steady
sync_fetch_crunchyroll = 7  # optional lane-specific override; task settings win over provider defaults when both exist
sync_apply = 3  # built-in default shown explicitly here
recommend_full_harvest = 5  # learned-history depth for the complete public MAL userrecs lane

[service.provider_projected_request_percentiles]
crunchyroll = 0.9  # built-in default shown explicitly here; override only when this host needs a different provider-wide conservative projection
hidive = 0.9  # built-in default shown explicitly here; override only when this host needs different HIDIVE learned-budget posture

[service.task_projected_request_percentiles]
sync_fetch_crunchyroll = 0.9  # optional conservative learned projection; when unset the daemon falls back to provider defaults, then smoothed/auto-bursty behavior
recommend_full_harvest = 0.9

[service.provider_warn_backoff_floor_seconds]
crunchyroll = 900  # built-in default shown explicitly here
hidive = 300  # built-in default shown explicitly here

[service.provider_critical_backoff_floor_seconds]
crunchyroll = 1800  # built-in default shown explicitly here
hidive = 1200  # built-in default shown explicitly here

[service.task_warn_backoff_floor_seconds]
sync_apply = 900  # built-in default shown explicitly here
recommend_full_harvest = 1800

[service.task_critical_backoff_floor_seconds]
sync_apply = 1800  # built-in default shown explicitly here
recommend_full_harvest = 3600

[service.provider_auth_failure_backoff_floor_seconds]
crunchyroll = 7200  # built-in default shown explicitly here
hidive = 3600  # built-in default shown explicitly here

[service.task_auth_failure_backoff_floor_seconds]
sync_apply = 2400  # built-in default shown explicitly here
recommend_full_harvest = 21600

[secret_files]
mal_client_id = "mal_client_id.txt"
mal_client_secret = "mal_client_secret.txt"
mal_access_token = "mal_access_token.txt"
mal_refresh_token = "mal_refresh_token.txt"
crunchyroll_username = "crunchyroll_username.txt"
crunchyroll_password = "crunchyroll_password.txt"
hidive_username = "hidive_username.txt"
hidive_password = "hidive_password.txt"
openclaw_hook_token = "openclaw_hook_token.txt"
