{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mal-updater.local/schemas/eval/event-v1.schema.json",
  "title": "MAL-Updater replay event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "user_id", "event_type", "source", "source_event_id", "source_revision", "occurred_at", "observed_at", "effective_from", "entity", "payload", "payload_sha256"],
  "properties": {
    "schema_version": {"const": "mal-eval-event/v1"},
    "event_id": {"type": "string", "minLength": 1},
    "user_id": {"type": "string", "minLength": 1},
    "event_type": {"enum": ["mal_list_state", "mal_progress", "provider_series_observed", "provider_episode_observed", "provider_play", "provider_watchlist_state", "availability_assertion", "english_audio_assertion", "mal_metadata_observed", "mal_relation_observed", "mal_recommendation_edge_observed", "seasonal_catalog_observed", "correction"]},
    "source": {"enum": ["mal", "crunchyroll", "hidive", "system", "fixture"]},
    "source_event_id": {"type": "string", "minLength": 1},
    "source_revision": {"type": "integer", "minimum": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "observed_at": {"type": "string", "format": "date-time"},
    "effective_from": {"type": "string", "format": "date-time"},
    "effective_to": {"type": ["string", "null"], "format": "date-time"},
    "supersedes_event_id": {"type": ["string", "null"]},
    "entity": {
      "type": "object", "additionalProperties": false, "required": ["entity_type", "entity_id"],
      "properties": {
        "entity_type": {"enum": ["anime", "season", "episode", "user_anime", "recommendation_edge", "availability"]},
        "entity_id": {"type": "string", "minLength": 1},
        "mal_anime_id": {"type": ["string", "null"]},
        "provider": {"type": ["string", "null"]},
        "provider_series_id": {"type": ["string", "null"]},
        "provider_episode_id": {"type": ["string", "null"]}
      }
    },
    "payload": {"type": "object"},
    "payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
